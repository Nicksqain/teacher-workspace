// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model StudyPlanChange {
  id        String @id @default(uuid())
  kind      String
  targetId  String @map("target_id")
  actorId   String @map("actor_id")
  before    Json
  after     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, targetId, createdAt])
  @@map("study_plan_changes")
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  password  String
  firstName String @map("first_name")
  lastName  String @map("last_name")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[] // Прямая неявная связь M:N

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique
  description String?
  roles       Role[] // Прямая неявная связь M:N

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model Lesson {
  id        String   @id @default(uuid())
  subject   String
  groupName String   @map("group_name")
  room      String
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")

  studyPlanId  String?              @map("study_plan_id")
  studyPlan    StudyPlan?           @relation(fields: [studyPlanId], references: [id], onDelete: Restrict)
  assignmentId String?              @map("assignment_id")
  assignment   StudyPlanAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  academicHours Int? @map("academic_hours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startsAt])
  @@map("lessons")
}

model StudyGroup {
  id        String          @id @default(uuid())
  name      String          @unique
  plans     StudyPlan[]
  subgroups StudySubgroup[]
  annualHours StudyPlanAnnualHours[]

  @@map("study_groups")
}

model Subject {
  id    String      @id @default(uuid())
  name  String      @unique
  plans StudyPlan[]
  annualHours StudyPlanAnnualHours[]

  @@map("subjects")
}

// Annual source hours; no semester is inferred from the workbook.
model StudyPlanAnnualHours {
  id                String @id @default(uuid())
  groupId           String @map("group_id")
  group             StudyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subjectId         String @map("subject_id")
  subject           Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicYear      String @map("academic_year")
  subgroupNumber    Int @default(0) @map("subgroup_number")
  partNumber        Int @default(0) @map("part_number")
  teacherLabel      String @map("teacher_label")
  examHours         Int @default(0) @map("exam_hours")
  consultationHours Int @default(0) @map("consultation_hours")
  projectHours      Int @default(0) @map("project_hours")

  @@unique([groupId, subjectId, academicYear, subgroupNumber, partNumber], map: "annual_hours_group_subject_year_subgroup_part_key")
  @@map("study_plan_annual_hours")
}

model StudyPlan {
  id           String                @id @default(uuid())
  groupId      String                @map("group_id")
  group        StudyGroup            @relation(fields: [groupId], references: [id])
  subjectId    String                @map("subject_id")
  subject      Subject               @relation(fields: [subjectId], references: [id])
  assignments  StudyPlanAssignment[]
  academicYear String?
  semester     Int?
  weeks        Int?
  period       String
  totalHours   Int                   @map("total_hours")
  lessons      Lesson[]

  @@unique([groupId, subjectId, period])
  @@map("study_plans")
}

model StudySubgroup {
  id          String                @id @default(uuid())
  groupId     String                @map("group_id")
  group       StudyGroup            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  number      Int
  assignments StudyPlanAssignment[]

  @@unique([groupId, number])
  @@map("study_subgroups")
}

model Teacher {
  id          String                @id @default(uuid())
  fullName    String                @map("full_name")
  assignments StudyPlanAssignment[]

  @@map("teacher")
}

model StudyPlanAssignment {
  id          String    @id @default(uuid())
  studyPlanId String    @map("study_plan_id")
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Restrict)

  subgroupNumber Int            @default(0) @map("subgroup_number")
  partNumber     Int            @default(0) @map("part_number")
  subgroupId     String?        @map("subgroup_id")
  subgroup       StudySubgroup? @relation(fields: [subgroupId], references: [id], onDelete: Restrict)

  examHours         Int @default(0) @map("exam_hours")
  consultationHours Int @default(0) @map("consultation_hours")
  projectHours      Int @default(0) @map("project_hours")

  teacherId String?  @map("teacher_id")
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  teacherLabel String   @map("teacher_label")
  totalHours   Int      @map("total_hours")
  lessons      Lesson[]

  @@unique([studyPlanId, subgroupNumber, partNumber], map: "plan_assignment_subgroup_part_key")
  @@map("study_plan_assignments")
}
