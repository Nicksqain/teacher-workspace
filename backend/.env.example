# Database Credentials
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_prod
POSTGRES_DB=teacher_workspace
POSTGRES_PORT=5432

# Redis Credentials
REDIS_PASSWORD=change_this_redis_password_in_prod
REDIS_PORT=6379

# Prisma / App Connections
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
REDIS_HOST="redis"

# Auth Secrets
JWT_SECRET="super-secret-jwt-key-replace-me"
JWT_EXPIRES_IN="1d"